APP=/opt/gomon/app/zadarma
PATH=/opt/gomon/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
VENV=/opt/gomon/venv/bin/python
# ↑ Змінні — ВИЩЕ всіх джоб: Vixie cron ігнорує змінні після них (6-денний збій, червень 2026).
#
# Джерело правди — цей файл у git (deploy/crontab). Деплой:
#   ssh root@45.94.157.127 'cd /opt/gomon/app && crontab -l > /opt/gomon/backups/crontab/crontab_$(date +%Y%m%d_%H%M).txt && crontab deploy/crontab'
# Руками на сервері не правити — tests/test_crontab.py перевіряє саме цей файл.
#
# Сервер і cron — у UTC. Київ = UTC+2 взимку, UTC+3 влітку, і переводити години
# руками більше не треба: кожна джоба з фіксованою годиною стоїть на ОБОХ можливих
# UTC-годинах, а kyiv_gate.py пропускає лише запуск у потрібний київський час.
# Ліворуч від kyiv_gate — коли крон смикає скрипт, праворуч — коли він справді працює.

# ── Інтервальні: від годинника не залежать ───────────────────────────────────
*/5 * * * *     cd $APP && $VENV health_check.py
*/5 * * * *     curl -s -X POST http://127.0.0.1:5001/api/deposit/reconcile > /dev/null 2>&1
0 * * * *       cd $APP && $VENV sync_appointments.py >> /var/log/gomon/sync.log 2>&1
0 */2 * * *     cd $APP && $VENV anthropic_health.py >> /var/log/gomon/anthropic_health.log 2>&1

# ── Нічне обслуговування ──────────────────────────────────────────────────────
# Бекап о 02:50, не о 03:00: у ніч переходу на літній час 03:00–03:59 Києва не існує
# (бекапу не було б), а в ніч переходу на зимовий ця година двічі (бекап двічі).
50 23,0 * * *   $VENV $APP/kyiv_gate.py 02:50 && for db in /opt/gomon/app/zadarma/*.db; do sqlite3 "$db" ".backup /opt/gomon/backups/$(basename $db .db)_$(date +\%Y\%m\%d).db"; done && find /opt/gomon/backups -name "*.db" -mtime +14 -delete
0 1,2 * * *     $VENV $APP/kyiv_gate.py 04:00 && sqlite3 /opt/gomon/app/zadarma/otp_sessions.db "DELETE FROM sessions WHERE expires_at < strftime('%s','now'); DELETE FROM otp_codes WHERE expires_at < strftime('%s','now'); DELETE FROM magic_tokens WHERE expires_at < strftime('%s','now');"
5 1,2 * * *     $VENV $APP/kyiv_gate.py 04:05 && sqlite3 /opt/gomon/app/zadarma/users.db "UPDATE manual_appointments SET status='DONE' WHERE date < date('now','-1 day') AND status='CONFIRMED';"
10 1,2 * * *    $VENV $APP/kyiv_gate.py 04:10 && sqlite3 /opt/gomon/app/zadarma/users.db "DELETE FROM appointment_audit_log WHERE created_at < datetime('now','-60 days');"

# ── Синхронізація й каталог ───────────────────────────────────────────────────
5 6,7,18,19 * * *   cd $APP && $VENV kyiv_gate.py 09:05,21:05 && PATH=/opt/gomon/venv/bin:$PATH bash sync_with_notification.sh >> /var/log/gomon/sync.log 2>&1
0 4,5,16,17 * * *   cd $APP && $VENV kyiv_gate.py 07:00,19:00 && $VENV wl_catalog.py --sync >> /var/log/gomon/wl_catalog.log 2>&1
0 4,5,16,17 * * *   cd $APP && $VENV kyiv_gate.py 07:00,19:00 && $VENV photo_cache.py >> /var/log/gomon/photo_cache.log 2>&1
0 5,6 * * *         cd $APP && $VENV kyiv_gate.py 08:00 && $VENV sync_reviews.py >> /var/log/gomon/reviews.log 2>&1
0 7,8 * * *         cd $APP && $VENV kyiv_gate.py 10:00 && $VENV ig_health.py > /dev/null 2>> /var/log/gomon/ig_health.log

# ── Клієнтам: нагадування, відгуки, кешбек ────────────────────────────────────
*/15 5-20 * * *     cd $APP && $VENV kyiv_gate.py 08:00-22:59 && $VENV push_reminder.py >> /var/log/gomon/push.log 2>&1
0 6-19 * * *        cd $APP && $VENV kyiv_gate.py 09:00-21:00 && $VENV sms_reminder.py >> /var/log/gomon/sms.log 2>&1
10 7,8,15,16 * * *  cd $APP && $VENV kyiv_gate.py 10:10,18:10 && $VENV appt_reminder.py --reminder >> /var/log/gomon/appt.log 2>&1
*/15 6-21 * * *     cd $APP && $VENV kyiv_gate.py 09:00-23:59 && $VENV appt_reminder.py --feedback >> /var/log/gomon/appt.log 2>&1
*/15 6-19 * * *     cd $APP && $VENV kyiv_gate.py 09:00-21:59 && $VENV photo_reminder.py --cashback-notify >> /var/log/gomon/photo.log 2>&1

# ── Спеціалістам і адміну ─────────────────────────────────────────────────────
0 8,9 * * *         cd $APP && $VENV kyiv_gate.py 11:00 && $VENV photo_reminder.py --check >> /var/log/gomon/photo.log 2>&1
0 18,19 * * *       cd $APP && $VENV kyiv_gate.py 21:00 && $VENV photo_reminder.py --create >> /var/log/gomon/photo.log 2>&1
5 18,19 * * *       cd $APP && $VENV kyiv_gate.py 21:05 && $VENV appt_reminder.py --specialist --tomorrow >> /var/log/gomon/appt.log 2>&1
10 19,20 * * *      cd $APP && $VENV kyiv_gate.py 22:10 && $VENV sms_reminder.py --daily-summary >> /var/log/gomon/sms.log 2>&1
